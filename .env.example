# Django Settings
DEBUG=False
SECRET_KEY=django-insecure-change-me-in-production-to-a-strong-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,your-domain.com

# Security Settings (for Railway behind proxy, keep as False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database (SQLite for now, use PostgreSQL on Railway for production)
DATABASE_URL=sqlite:///db.sqlite3

# Gunicorn Workers
WORKERS=4
